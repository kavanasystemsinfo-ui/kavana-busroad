# Configuración del backend — copia a .env y rellena

# MOTOR PRINCIPAL: OpenRouteService (restricciones de dimensiones reales en Europa)
# Perfil driving-hgv (vehículos pesados): altura, anchura, largo y peso.
# Clave gratuita: https://openrouteservice.org/dev-portal/ (2.000 rutas/día)
ORS_API_KEY=

# MOTOR SECUNDARIO: Google Routes API (ruta estándar de conducción)
# NOTA: Google NO aplica restricciones de dimensiones fuera de EE.UU.
GOOGLE_API_KEY=

# Puerto del servidor local
PORT=8000

# Límite diario de rutas NUEVAS (miss de caché) por IP en /api/v1/ruta.
# Una ruta cacheada repetida no cuenta (no gasta cuota ORS). Default 30.
RUTAS_MAX_POR_IP_DIA=30

# Ruta del fichero de caché + rate limit (JSON). Por defecto store.json en
# el CWD; en Fly.io el CWD es /app y el fichero sobrevive al auto-stop.
# BUSROAD_STORE_PATH=store.json
